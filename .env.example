# ── Supabase (optional) ──────────────────────────────────────────────────────
# Enables a shared, public book list so anyone with your suggest link can add
# recommendations. Without these, the app stores data in localStorage only.
#
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Anthropic (optional) ─────────────────────────────────────────────────────
# Enables AI taste-match scoring and personal "why read this" pitches.
# Without it, books are added without scores; you can still import a taste CSV.
# Users can also enter their key in the app Settings UI (stored in localStorage).
#
# Get from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-...
