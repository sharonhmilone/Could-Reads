# ── Supabase (client-side — safe to expose) ──────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (server-side only — keep secret) ─────────────────────────────────
# Used by the Vercel Edge Function to verify auth tokens.
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# Add to Vercel as a non-VITE_ environment variable (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Anthropic (server-side only — keep secret) ────────────────────────────────
# Used by the Vercel Edge Function to call Claude. Never exposed to the browser.
# Get from: https://console.anthropic.com/
# Add to Vercel as a non-VITE_ environment variable
ANTHROPIC_API_KEY=sk-ant-...

# ── Share token (server-side only) ────────────────────────────────────────────
# Allows the suggest form to generate pitches without a full login.
# Get the value from Settings → Copy suggest link — it's the "t=xxx" part of the URL.
# Paste the token (just the hex string) here and add to Vercel env vars.
SHARE_TOKEN=your-share-token-here
